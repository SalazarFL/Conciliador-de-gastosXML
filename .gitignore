# Runtime logs
storage/logs/*.log

# Archivos que sube la gente (artefactos de ejecución).
# Son reportes reales del ERP: proveedores, cédulas y montos de la empresa.
# El repositorio es público — nada de esto se versiona.
public/uploads/xml/*
public/uploads/gastos/*
public/uploads/xml_queue/*
public/uploads/porpagar/*
public/uploads/notas_credito/*
public/uploads/facturas_erp/*

# Keep upload directories in repo structure if needed
!public/uploads/xml/.gitkeep
!public/uploads/gastos/.gitkeep
!public/uploads/xml_queue/.gitkeep
!public/uploads/porpagar/.gitkeep
!public/uploads/notas_credito/.gitkeep
!public/uploads/facturas_erp/.gitkeep

# Temporary/scratch scripts
.tmp_*

# Runtime cache
storage/cache/*.json
storage/cache/*.marca

# Session files (runtime)
storage/sessions/

# Locks de procesos (runtime)
storage/locks/

# Documentos bajados del almacén para lo que necesita un archivo de verdad
# (ZIP, pdftotext). Son copias de comprobantes reales: nunca se versionan.
storage/tmp/

# PDFs de devoluciones archivados por la app (runtime)
storage/devoluciones/

# Configuración de esta computadora: contraseña de la base y rutas propias.
# El repositorio es público; la plantilla versionada es local.ejemplo.php.
app/config/local.php
# Perfiles de conexión (local.oficina.php, local.propia.php) y las copias que
# cambiar-base.ps1 guarda antes de pisar un local.php editado a mano.
app/config/local.*.php
app/config/local.php.antes-*
!app/config/local.ejemplo.php

# Correo IMAP: credenciales reales y archivos capturados del buzón
app/config/correo.php
storage/correo/
storage/backups/

# Local-only utilities and notes (never deploy/commit)
public/create_admin.php
MEMORY.md

# Respaldos que se sacan antes de copiar código a la carpeta que se sirve.
# Son copias de archivos que git ya versiona —el respaldo de verdad es el
# repositorio— así que no tienen por qué entrar en un commit.
storage/respaldo_predespliegue_*/

# Catálogo de proveedores generado en runtime: son CSV con datos reales
# (proveedores, cédulas) de la empresa. El repositorio es público.
storage/catalogo_proveedores/

# Progreso de tareas en runtime (jobs en curso), no es código.
storage/progreso/

# Capturas y logs de pruebas Playwright (artefactos de ejecución local).
.playwright-mcp/

# Carpeta que aparece por una ruta con %SystemDrive% sin expandir al copiar
# archivos; termina con caché de Windows adentro. No es parte del proyecto.
public/%SystemDrive%/

# Runtime logs
storage/logs/*.log

# Archivos que sube la gente (artefactos de ejecución).
# Son reportes reales del ERP: proveedores, cédulas y montos de la empresa.
# El repositorio es público — nada de esto se versiona.
public/uploads/xml/*
public/uploads/gastos/*
public/uploads/xml_queue/*
public/uploads/porpagar/*
public/uploads/notas_credito/*
public/uploads/facturas_erp/*

# Keep upload directories in repo structure if needed
!public/uploads/xml/.gitkeep
!public/uploads/gastos/.gitkeep
!public/uploads/xml_queue/.gitkeep
!public/uploads/porpagar/.gitkeep
!public/uploads/notas_credito/.gitkeep
!public/uploads/facturas_erp/.gitkeep

# Temporary/scratch scripts
.tmp_*

# Runtime cache
storage/cache/*.json

# Session files (runtime)
storage/sessions/

# Locks de procesos (runtime)
storage/locks/

# PDFs de devoluciones archivados por la app (runtime)
storage/devoluciones/

# Correo IMAP: credenciales reales y archivos capturados del buzón
app/config/correo.php
storage/correo/
storage/backups/

# Local-only utilities and notes (never deploy/commit)
public/create_admin.php
MEMORY.md
